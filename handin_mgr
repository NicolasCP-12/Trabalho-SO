    case $1 in
        1|2|3|4|5) return 0 ;;
        *) return 1 ;;
    esac
}





acquire_lock() {
     while ! mkdir "$LOCKS/main.lock" 2>/dev/null; do
        sleep 1
    done
    :
}

release_lock() {
    rmdir "$LOCKS/main.lock" 2>/dev/null
    :
}





cmd_todo_add() {
    [ "${1-}" = "-h" ] && {
        print_todo_add_help
        return 0
    }
titulo=""
    prioridade=3
    data=""
    tags=""
    
    # Percorrer todos os argumentos
    while [ $# -gt 0 ]; do
        case "$1" in
            -p)
                prioridade="$2"
                shift 2
                ;;
            -d)
                data="$2"
                shift 2
                ;;
            -t)
                tags="$2"
                shift 2
                ;;
            *)
                
                titulo="$1"
                shift
                ;;
        esac
    done
    
    # Verificar se o título foi informado
    if [ -z "$titulo" ]; then
        echo "Erro: Título é obrigatório" >&2
        return 1
    fi
    
    # Verificar se prioridade é válida (1 a 5)
    if [ "$prioridade" -lt 1 ] || [ "$prioridade" -gt 5 ]; then
        echo "Erro: Prioridade deve ser entre 1 e 5" >&2
        return 1
    fi
    
    # Verificar data se foi informada
    if [ -n "$data" ]; then
        # Verifica se tem formato AAAA-MM-DD
        echo "$data" | grep -qE '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
        if [ $? -ne 0 ]; then
            echo "Erro: Data deve ser AAAA-MM-DD" >&2
            return 1
        fi
    fi
    
    
    acquire_lock
    
    # Calcular o próximo ID
    if [ -s "$TODOS" ]; then
        ultimo_id=$(cut -d';' -f1 "$TODOS" | sort -n | tail -1)
        next_id=$((ultimo_id + 1))
    else
        next_id=1
    fi
    
    
    agora=$(date '+%Y-%m-%d %H:%M:%S')
    
    # Escrever no arquivo CSV
    echo "$next_id;OPEN;$prioridade;$data;$tags;$agora;;$titulo" >> "$TODOS"
    
    
    release_lock
    
    echo "Tarefa $next_id criada com sucesso"
}




cmd_todo_list() {
    [ "${1-}" = "-h" ] && {
        print_todo_list_help
        return 0
    }
mostrar_todas=""
    ordenar=""
    tag_filtro=""
    prio_min=0
    
    # Processar argumentos
    while [ $# -gt 0 ]; do
        case "$1" in
            -a)
                mostrar_todas="sim"
                shift
                ;;
            -s)
                ordenar="$2"
                shift 2
                ;;
            -t)
                tag_filtro="$2"
                shift 2
                ;;
            -p)
                prio_min="$2"
                shift 2
                ;;
            *)
                echo "Erro: Opção desconhecida $1" >&2
                return 1
                ;;
        esac
    done
    
    # Verificar se arquivo existe
    if [ ! -f "$TODOS" ]; then
        echo "Nenhuma tarefa encontrada"
        return 0
    fi
    
    # Filtrar por status (OPEN ou todas)
    if [ -z "$mostrar_todas" ]; then
        # Mostrar só OPEN
        grep -v '^[^;]*;DONE;' "$TODOS" > /tmp/tarefas_temp
    else
        # Mostrar todas
        cp "$TODOS" /tmp/tarefas_temp
    fi
    
    # Filtrar por prioridade mínima
    if [ "$prio_min" -gt 0 ]; then
        awk -F';' -v p="$prio_min" '$3 >= p' /tmp/tarefas_temp > /tmp/tarefas_temp2
        mv /tmp/tarefas_temp2 /tmp/tarefas_temp
    fi
    
    # Filtrar por tag
    if [ -n "$tag_filtro" ]; then
        grep ";$tag_filtro,\|,$tag_filtro\|;$tag_filtro$" /tmp/tarefas_temp > /tmp/tarefas_temp2
        mv /tmp/tarefas_temp2 /tmp/tarefas_temp
    fi
    
    # Ordenar
    case "$ordenar" in
        due)
            sort -t';' -k4,4 /tmp/tarefas_temp > /tmp/tarefas_temp2
            ;;
        prio)
            sort -t';' -k3,3 -r /tmp/tarefas_temp > /tmp/tarefas_temp2
            ;;
        created)
            sort -t';' -k6,6 /tmp/tarefas_temp > /tmp/tarefas_temp2
            ;;
        *)
            cat /tmp/tarefas_temp > /tmp/tarefas_temp2
            ;;
    esac
    
    # Mostrar resultado
    while IFS=';' read -r id status prio due tags created done title; do
        echo "[$id] (P$prio) $due $status tags:$tags - $title"
    done < /tmp/tarefas_temp2
    
    # Limpar arquivo temporário
    rm -f /tmp/tarefas_temp /tmp/tarefas_temp2
}







cmd_todo_done() {
    [ "${1-}" = "-h" ] && {
        print_todo_done_help
        return 0
    }
id="$1"
    
    # Verificar se ID foi informado
    if [ -z "$id" ]; then
        echo "Erro: ID da tarefa é obrigatório" >&2
        return 1
    fi
    
    # Verificar se arquivo existe
    if [ ! -f "$TODOS" ]; then
        echo "Erro: Nenhuma tarefa encontrada" >&2
        return 1
    fi
    
    # Pegar lock
    acquire_lock
    
    # Procurar a tarefa
    if grep -q "^$id;" "$TODOS"; then
        # Verificar se já está DONE
        if grep "^$id;DONE;" "$TODOS" > /dev/null; then
            echo "Tarefa $id já está concluída"
            release_lock
            return 0
        fi
        
        
        agora=$(date '+%Y-%m-%d %H:%M:%S')
        
        # Atualizar a linha
        awk -F';' -v id="$id" -v agora="$agora" '
            $1 == id {
                $2 = "DONE"
                $8 = agora
            }
            { print $1";"$2";"$3";"$4";"$5";"$6";"$7";"$8 }
        ' "$TODOS" > "$TODOS.tmp"
        
        mv "$TODOS.tmp" "$TODOS"
        echo "Tarefa $id marcada como concluída"
    else
        echo "Erro: Tarefa com ID $id não encontrada" >&2
        release_lock
        return 1
    fi
    
    release_lock

    
}







cmd_todo_search() {

    # Se for pedir ajuda
    [ "${1-}" = "-h" ] && {
        print_todo_search_help
        return 0
    }

    # Pegar o texto para buscar
    texto="$1"
    
    # Verificar se texto foi informado
    if [ -z "$texto" ]; then
        echo "Erro: Texto para busca é obrigatório" >&2
        return 1
    fi
    
    # Verificar se arquivo existe
    if [ ! -f "$TODOS" ]; then
        echo "Nenhuma tarefa encontrada"
        return 0
    fi
    
    # Buscar no título (case insensitive)
    while IFS=';' read -r id status prio due tags created done title; do
        # Converter título e texto para minúsculas e comparar
        echo "$title" | grep -qi "$texto"
        if [ $? -eq 0 ]; then
            echo "[$id] (P$prio) $due $status tags:$tags - $title"
        fi
    done < "$TODOS"
}







cmd_handin_ingest() {
    # Se for pedir ajuda
    [ "${1-}" = "-h" ] && {
        print_handin_ingest_help
        return 0
    }

    inbox_dir="$1"
    repo_dir="$2"
    mover=""
    
    # Verificar opção -m
    if [ "$3" = "-m" ]; then
        mover="sim"
    fi
    
    # Verificar se as pastas existem
    if [ ! -d "$inbox_dir" ]; then
        echo "Erro: Pasta inbox não existe: $inbox_dir" >&2
        return 1
    fi
    
    if [ ! -d "$repo_dir" ]; then
        echo "Erro: Pasta repo não existe: $repo_dir" >&2
        return 1
    fi
    
    # Criar timestamp para o relatório
    timestamp=$(date '+%Y-%m-%d_%H%M%S')
    relatorio="$RUNS/ingest_$timestamp.txt"
    
    echo "Processando entregas em: $inbox_dir"
    
    # Para cada arquivo/pasta no inbox
    for item in "$inbox_dir"/*; do
        if [ -f "$item" ] || [ -d "$item" ]; then
            nome=$(basename "$item")
            
            # Tentar extrair informações do nome
            # Formato esperado: ALUNO_UC_TP#_TIMESTAMP
            echo "$nome" | grep -qE '^[A-Za-z0-9]+_[A-Za-z0-9]+_TP[0-9]+_[0-9]{12}$'
            if [ $? -eq 0 ]; then
                # Nome válido
                aluno=$(echo "$nome" | cut -d'_' -f1)
                uc=$(echo "$nome" | cut -d'_' -f2)
                tp=$(echo "$nome" | cut -d'_' -f3)
                timestamp_nome=$(echo "$nome" | cut -d'_' -f4)
                
                # Criar destino
                destino="$repo_dir/$uc/$tp/$aluno/$timestamp_nome"
                mkdir -p "$destino"
                
                # Copiar ou mover
                if [ -d "$item" ]; then
                    cp -r "$item"/* "$destino/" 2>/dev/null
                else
                    cp "$item" "$destino/" 2>/dev/null
                fi
                
                if [ "$mover" = "sim" ]; then
                    rm -rf "$item"
                fi
                
                echo "OK;$item;$destino" >> "$relatorio"
                echo "  OK: $nome -> $destino"
            else
                echo "FAIL;$item;nome_invalido" >> "$relatorio"
                echo "  FAIL: $nome (nome inválido)"
            fi
        fi
    done
    
    echo "Relatório salvo em: $relatorio"
}








cmd_handin_check() {
    # Se for pedir ajuda
    [ "${1-}" = "-h" ] && {
        print_handin_check_help
        return 0
    }

    repo_dir="$1"
    output_file=""
    
    # Verificar opção -o
    if [ "$2" = "-o" ]; then
        output_file="$3"
    fi
    
    # Verificar se repo existe
    if [ ! -d "$repo_dir" ]; then
        echo "Erro: Pasta repo não existe: $repo_dir" >&2
        return 1
    fi
    
    # Criar cabeçalho do relatório
    if [ -n "$output_file" ]; then
        echo "UC;TP#;ALUNO;timestamp;STATUS;num_src_files;total_files;total_lines;problemas" > "$output_file"
    else
        echo "UC;TP#;ALUNO;timestamp;STATUS;num_src_files;total_files;total_lines;problemas"
    fi
    
    # Percorrer todas as entregas
    for uc in "$repo_dir"/*; do
        [ -d "$uc" ] || continue
        for tp in "$uc"/*; do
            [ -d "$tp" ] || continue
            for aluno in "$tp"/*; do
                [ -d "$aluno" ] || continue
                for entrega in "$aluno"/*; do
                    [ -d "$entrega" ] || continue
                    
                    nome_uc=$(basename "$uc")
                    nome_tp=$(basename "$tp")
                    nome_aluno=$(basename "$aluno")
                    timestamp=$(basename "$entrega")
                    
                    # Verificar README
                    problemas=""
                    if [ ! -f "$entrega/README.md" ] && [ ! -f "$entrega/README.txt" ]; then
                        problemas="missing_readme"
                    fi
                    
                    # Verificar pasta src
                    if [ ! -d "$entrega/src" ]; then
                        if [ -n "$problemas" ]; then
                            problemas="$problemas,missing_src"
                        else
                            problemas="missing_src"
                        fi
                        num_src=0
                    else
                        num_src=$(find "$entrega/src" -type f | wc -l)
                    fi
                    
                    # Contar arquivos totais
                    total_files=$(find "$entrega" -type f | wc -l)
                    
                    # Contar linhas
                    total_lines=$(find "$entrega" -type f -exec cat {} \; 2>/dev/null | wc -l)
                    
                    # Decidir status
                    if [ -n "$problemas" ]; then
                        status="FAIL"
                        # Criar tarefa automática
                        cmd_todo_add "Corrigir entrega $nome_aluno $nome_uc $nome_tp ($problemas)" -p 4 -t "handin,$nome_uc,$nome_tp"
                    else
                        status="OK"
                    fi
                    
                    # Escrever no relatório
                    linha="$nome_uc;$nome_tp;$nome_aluno;$timestamp;$status;$num_src;$total_files;$total_lines;$problemas"
                    
                    if [ -n "$output_file" ]; then
                        echo "$linha" >> "$output_file"
                    else
                        echo "$linha"
                    fi
                done
            done
        done
    done
}







cmd_handin_summary() {
    # Se for pedir ajuda
    [ "${1-}" = "-h" ] && {
        print_handin_summary_help
        return 0
    }

    repo_dir="$1"
    filtro_uc=""
    filtro_tp=""
    
    # Processar argumentos
    shift
    while [ $# -gt 0 ]; do
        case "$1" in
            -u)
                filtro_uc="$2"
                shift 2
                ;;
            -t)
                filtro_tp="$2"
                shift 2
                ;;
            *)
                shift
                ;;
        esac
    done
    
    # Verificar se repo existe
    if [ ! -d "$repo_dir" ]; then
        echo "Erro: Pasta repo não existe: $repo_dir" >&2
        return 1
    fi
    
    echo "=== Resumo de Entregas ==="
    if [ -n "$filtro_uc" ]; then
        echo "Filtro UC: $filtro_uc"
    fi
    if [ -n "$filtro_tp" ]; then
        echo "Filtro TP: $filtro_tp"
    fi
    echo ""
    
    # Contadores
    total=0
    ok=0
    fail=0
    
    # Percorrer e contar
    for uc in "$repo_dir"/*; do
        [ -d "$uc" ] || continue
        nome_uc=$(basename "$uc")
        [ -n "$filtro_uc" ] && [ "$nome_uc" != "$filtro_uc" ] && continue
        
        for tp in "$uc"/*; do
            [ -d "$tp" ] || continue
            nome_tp=$(basename "$tp")
            [ -n "$filtro_tp" ] && [ "$nome_tp" != "$filtro_tp" ] && continue
            
            for aluno in "$tp"/*; do
                [ -d "$aluno" ] || continue
                for entrega in "$aluno"/*; do
                    [ -d "$entrega" ] || continue
                    
                    total=$((total + 1))
                    
                    # Verificar status (simplificado - verifica se tem src e README)
                    if [ -d "$entrega/src" ] && ([ -f "$entrega/README.md" ] || [ -f "$entrega/README.txt" ]); then
                        ok=$((ok + 1))
                    else
                        fail=$((fail + 1))
                        echo "Aluno com FAIL: $(basename "$aluno")"
                    fi
                done
            done
        done
    done
    
    echo ""
    echo "Total de entregas: $total"
    echo "OK: $ok"
    echo "FAIL: $fail"
}






dispatch() {
    [ $# -gt 0 ] || {
        err "Falta comando"
        return 1
    }

    case $1 in
        todo-add)
            shift
            cmd_todo_add "$@"
            ;;
        todo-list)
            shift
            cmd_todo_list "$@"
            ;;
        todo-done)
            shift
            cmd_todo_done "$@"
            ;;
        todo-search)
            shift
            cmd_todo_search "$@"
            ;;
        handin-ingest)
            shift
            cmd_handin_ingest "$@"
            ;;
        handin-check)
            shift
            cmd_handin_check "$@"
            ;;
        handin-summary)
            shift
            cmd_handin_summary "$@"
            ;;
        -h|--help)
            print_general_help
            ;;
        *)
            err "Comando invalido: $1"
            return 1
            ;;
    esac
}

run_shell() {
    ensure_state

    printf 'Shell interativa de %s\n' "$PROG"
    printf 'Escreve help para ajuda e exit para sair\n'

    while :; do
        printf 'shell> '
        IFS= read -r line || {
            printf '\n'
            break
        }

        case $line in
            '')
                continue
                ;;
            exit|exist)
                break
                ;;
            help)
                print_general_help
                continue
                ;;
            "$PROG "*)
                cmdline=${line#"$PROG "}
                ;;
            "$PROG")
                err "Falta o comando"
                continue
                ;;
            *)
                err "Usa comandos no formato: $PROG <comando> ..."
                continue
                ;;
        esac

        # Nota:
        # esta divisao por espacos e simples e nao trata aspas
        # complexas como uma shell real
        set -- $cmdline
        [ $# -gt 0 ] || continue

        dispatch "$@"
        rc=$?
        [ "$rc" -eq 0 ] || err "Comando terminou com codigo $rc"
    done
}

run_shell


